{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "next_question",
    "icp_markdown",
    "icp_json",
    "version",
    "coverage",
    "changes",
    "requires_approval",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "needs_answer",
        "ready",
        "incomplete"
      ],
      "description": "needs_answer: ask next_question and call again. ready: every required field resolved. incomplete: the interview ended with gaps."
    },
    "next_question": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "field",
        "text",
        "why",
        "example_answer"
      ],
      "additionalProperties": false,
      "description": "The one question to ask the founder next; null unless status is needs_answer.",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "segment",
            "buyer",
            "pain",
            "trigger",
            "channel",
            "disqualifier"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "why": {
          "type": "string",
          "maxLength": 200,
          "description": "Why this is being asked, in one plain sentence."
        },
        "example_answer": {
          "type": "string",
          "maxLength": 200,
          "description": "The shape of a specific answer, for a made-up company."
        }
      }
    },
    "icp_markdown": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3000,
      "description": "The ICP document (Must-have, Nice-to-have, Disqualifiers, Top pains (ranked), Buying triggers, Changelog); null with needs_answer."
    },
    "icp_json": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "icp_version",
        "segments",
        "anti_icp"
      ],
      "description": "The same ICP as icp_markdown in the shared contract (icp_version, segments[], anti_icp[]); null with needs_answer.",
      "properties": {
        "icp_version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "must_have",
              "nice_to_have",
              "disqualifiers",
              "top_pains",
              "triggers",
              "buyers",
              "confidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 60
              },
              "must_have": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 160
                },
                "description": "Must-have lines without their tags."
              },
              "nice_to_have": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 160
                },
                "description": "Nice-to-have lines without their tags."
              },
              "disqualifiers": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 160
                },
                "description": "Disqualifier lines without their tags."
              },
              "top_pains": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "maxLength": 160
                },
                "description": "Pains, ranked."
              },
              "triggers": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "maxLength": 160
                },
                "description": "Buying trigger lines without their tags."
              },
              "buyers": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "maxLength": 160
                },
                "description": "The Buyer: lines without the prefix."
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "hypothesis",
                  "partial",
                  "validated"
                ]
              }
            }
          }
        },
        "anti_icp": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "description": "Who not to pursue and why: the Anti-ICP lines without their tags."
        }
      }
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^v[0-9]+$",
      "description": "The document's version, e.g. v1; null with needs_answer."
    },
    "coverage": {
      "type": "object",
      "required": [
        "segment",
        "buyer",
        "pain",
        "trigger",
        "channel",
        "disqualifier",
        "questions_asked",
        "questions_left"
      ],
      "additionalProperties": false,
      "properties": {
        "segment": {
          "type": "boolean"
        },
        "buyer": {
          "type": "boolean"
        },
        "pain": {
          "type": "boolean"
        },
        "trigger": {
          "type": "boolean"
        },
        "channel": {
          "type": "boolean"
        },
        "disqualifier": {
          "type": "boolean"
        },
        "questions_asked": {
          "type": "integer",
          "minimum": 0
        },
        "questions_left": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 30,
      "description": "Differences from current_icp; empty for a first version or when nothing changed.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "section",
          "from",
          "to",
          "material"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "edit"
            ]
          },
          "section": {
            "type": "string",
            "enum": [
              "must_have",
              "nice_to_have",
              "disqualifiers",
              "anti_icp",
              "top_pains",
              "buying_triggers"
            ]
          },
          "from": {
            "type": "string",
            "maxLength": 200,
            "description": "The current line; empty for an add."
          },
          "to": {
            "type": "string",
            "maxLength": 200,
            "description": "The new line; empty for a remove."
          },
          "material": {
            "type": "boolean",
            "description": "True for any Must-have or Disqualifiers change, or a removed pain or trigger."
          }
        }
      }
    },
    "requires_approval": {
      "type": "boolean",
      "description": "True when any change is material: the save step must wait for the founder's approval."
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
