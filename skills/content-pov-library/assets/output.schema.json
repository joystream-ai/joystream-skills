{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "markdown",
    "worldview",
    "stances",
    "questions",
    "feedback_applied",
    "skipped",
    "report"
  ],
  "properties": {
    "markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000,
      "description": "The point-of-view document, GitHub-flavored Markdown: the run's readable result."
    },
    "worldview": {
      "type": "string",
      "minLength": 0,
      "maxLength": 700,
      "description": "The paragraph the stances add up to; empty when there are no stances."
    },
    "stances": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "headline",
          "stance",
          "pillar",
          "strength",
          "argument",
          "common_belief",
          "we_believe",
          "reasons",
          "proof",
          "concede",
          "so_what",
          "use_when",
          "angles",
          "say",
          "never_say",
          "gaps"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "stance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "pillar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "strength": {
            "type": "string",
            "enum": [
              "strong",
              "emerging"
            ]
          },
          "argument": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900
          },
          "common_belief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "we_believe": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "reasons": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "point",
                "quote",
                "source_id"
              ],
              "properties": {
                "point": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Copied character for character from the company's own page or the notes."
                },
                "source_id": {
                  "type": "string",
                  "pattern": "^S[0-9]+$"
                }
              }
            }
          },
          "proof": {
            "type": "array",
            "minItems": 0,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "point",
                "quote",
                "source_id"
              ],
              "properties": {
                "point": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Copied character for character from the company's own page or the notes."
                },
                "source_id": {
                  "type": "string",
                  "pattern": "^S[0-9]+$"
                }
              }
            }
          },
          "concede": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "so_what": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "use_when": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "angles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "contrarian",
                "myth_vs_reality",
                "prediction",
                "agree_and_extend",
                "lesson_from_building",
                "unpopular_opinion"
              ]
            }
          },
          "say": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "never_say": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "gaps": {
            "type": "array",
            "minItems": 0,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "description": "The stances, ranked, for agents that use them."
    },
    "questions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "question"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "description": "Questions for the founders where the writing takes no side. Never answered by the skill."
    },
    "feedback_applied": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "outcome"
        ],
        "properties": {
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "outcome": {
            "type": "string",
            "enum": [
              "applied",
              "dropped",
              "not_supported"
            ]
          }
        }
      },
      "description": "What happened to each feedback request; empty without feedback."
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_ours",
        "not_a_side",
        "no_quote",
        "generic",
        "duplicate",
        "over_budget"
      ],
      "properties": {
        "not_ours": {
          "type": "integer",
          "minimum": 0
        },
        "not_a_side": {
          "type": "integer",
          "minimum": 0
        },
        "no_quote": {
          "type": "integer",
          "minimum": 0
        },
        "generic": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "over_budget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}