{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_markdown",
    "marks",
    "left_alone"
  ],
  "properties": {
    "report_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000,
      "description": "The report: result, what to change, checked and left alone, then the draft marked up in place."
    },
    "marks": {
      "type": "integer",
      "minimum": 0,
      "description": "Rows in What to change."
    },
    "left_alone": {
      "type": "integer",
      "minimum": 0,
      "description": "Bullets in Checked and left alone."
    }
  }
}
