{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "targets"
  ],
  "additionalProperties": true,
  "properties": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "description": "The companies (and people or titles there) to find warm paths to.",
      "items": {
        "type": "object",
        "required": [
          "company"
        ],
        "additionalProperties": true,
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "domain": {
            "type": "string",
            "maxLength": 253,
            "description": "Website domain, e.g. example.com. Needed to match calendar attendees."
          },
          "people": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "Names of people there the user wants to reach."
          },
          "roles": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": "Titles the user wants to reach."
          }
        }
      }
    },
    "own_domains": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      },
      "description": "The user's own email domains; attendees on them are colleagues, never paths."
    },
    "recent_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1095,
      "default": 180,
      "description": "A meeting inside [now - recent_days, now] is recent."
    },
    "max_paths_per_target": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 3
    },
    "now": {
      "type": "string",
      "description": "Current time, ISO 8601. Optional: on JoyStream the template binds it to the run start time. Never guessed."
    }
  }
}
