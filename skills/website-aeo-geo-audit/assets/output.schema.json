{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "overall_score",
    "categories",
    "strengths",
    "gaps",
    "recommendations",
    "report_markdown",
    "summary_markdown",
    "report"
  ],
  "properties": {
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Mean of the six category scores, times ten, rounded."
    },
    "verdict": {
      "type": "string",
      "description": "One sentence on where the site stands."
    },
    "site_files": {
      "type": "object",
      "properties": {
        "robots_txt": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "unreachable"
          ]
        },
        "llms_txt": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "unreachable"
          ]
        },
        "sitemap": {
          "type": "string",
          "enum": [
            "present",
            "missing",
            "unreachable"
          ]
        }
      }
    },
    "client_rendered": {
      "type": "boolean",
      "description": "True when the homepage came back empty or asked for JavaScript."
    },
    "categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "key",
          "score",
          "summary",
          "confidence"
        ],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "crawler_access",
              "llms_txt",
              "answerability",
              "metadata",
              "external_authority",
              "depth_freshness"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "summary": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "verified",
              "partial",
              "unverified"
            ]
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "priority",
          "action"
        ],
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "description": "Concrete enough for a web team to do without more research."
          },
          "effort": {
            "type": "string",
            "enum": [
              "quick_fix",
              "project"
            ]
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "kind"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "site",
              "third_party"
            ]
          }
        }
      }
    },
    "keyword_coverage": {
      "type": "array",
      "maxItems": 20,
      "description": "One entry per input keyword, in input order. Absent when no keywords were given.",
      "items": {
        "type": "object",
        "required": [
          "keyword",
          "on_site",
          "in_search"
        ],
        "additionalProperties": false,
        "properties": {
          "keyword": {
            "type": "string"
          },
          "on_site": {
            "type": "string",
            "enum": [
              "answered",
              "mentioned",
              "absent",
              "unverified"
            ]
          },
          "in_search": {
            "type": "string",
            "enum": [
              "ranks",
              "not_ranking",
              "not_searched"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            }
          }
        }
      }
    },
    "changes_since_last_run": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "description": "What changed since the previous audit's saved state, one line per change. Absent when there was no previous state for this site."
    },
    "state_out": {
      "title": "State to remember",
      "description": "What a skill that compares over time asks the agent to save for the next run. Copied into properties.state_out of each output schema that has a state_out property. The skill never saves it; a later write step does (Sheets, Notion, a memory connector, or platform memory once it exists).",
      "type": "object",
      "required": [
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "item_key",
              "fingerprint",
              "observed_at"
            ],
            "additionalProperties": false,
            "properties": {
              "item_key": {
                "type": "string",
                "pattern": "^[a-z_]+:\\S+$",
                "maxLength": 200
              },
              "fingerprint": {
                "type": "string",
                "maxLength": 500,
                "description": "A short, stable summary of what was observed (e.g. sorted event urls, a price string), compared on the next run to detect change."
              },
              "observed_at": {
                "type": "string",
                "description": "The run's `now` input."
              },
              "data": {
                "type": "object",
                "description": "Small extra fields the next run needs. Keep it under 2 KB."
              }
            }
          }
        }
      }
    },
    "report_markdown": {
      "type": "string",
      "description": "The full audit report."
    },
    "summary_markdown": {
      "type": "string",
      "description": "Headline score, top three strengths, top three gaps — under summary_max_chars, ready to post verbatim."
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
