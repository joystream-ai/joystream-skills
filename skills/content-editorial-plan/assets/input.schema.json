{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "inputs"
  ],
  "additionalProperties": true,
  "properties": {
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "description": "One entry per read step, in the order the agent runs them: which kind of input it holds and the step's label.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "performance",
              "market",
              "customer",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "pillars": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": "Content themes the author owns. A slot's pillar is one of them, copied exactly, or null."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "default": [
        "linkedin"
      ],
      "items": {
        "type": "string",
        "enum": [
          "linkedin",
          "x",
          "blog",
          "newsletter",
          "youtube",
          "instagram"
        ]
      },
      "description": "Platforms to plan for."
    },
    "slots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 3,
      "description": "How many posts to plan."
    },
    "plan_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14,
      "default": 7,
      "description": "Days the plan covers, from start_date."
    },
    "start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "First day of the plan, YYYY-MM-DD. Default: the first Monday after now."
    },
    "lookback_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 14,
      "description": "Only messages and rows dated in [now - lookback_days, now] are inputs."
    },
    "now": {
      "type": "string",
      "description": "Current time, ISO 8601. Optional: on JoyStream the template binds it to the run start time. Never guessed."
    }
  }
}
