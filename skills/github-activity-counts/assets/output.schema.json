{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "outcome",
    "repos",
    "totals",
    "complete",
    "sentence",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "merged",
          "opened"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": {
            "type": "string"
          },
          "merged": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "opened": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "merged",
        "opened"
      ],
      "additionalProperties": false,
      "properties": {
        "merged": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "opened": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "sentence": {
      "type": "string"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
