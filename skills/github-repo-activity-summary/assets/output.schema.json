{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "markdown",
    "repos",
    "empty_result",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "markdown": {
      "type": "string",
      "description": "The digest, one block per repository in repositories order, ready to post verbatim."
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "status",
          "merged_prs",
          "opened_prs",
          "themes",
          "housekeeping_count"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": {
            "type": "string",
            "description": "owner/repo."
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_activity",
              "unreadable"
            ]
          },
          "merged_prs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "number",
                "title",
                "url",
                "hours_ago"
              ],
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "html_url exactly as in the evidence."
                },
                "author": {
                  "type": "string",
                  "description": "The author's login, as in the evidence."
                },
                "hours_ago": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Whole hours from merged_at (merged) or created_at (opened) to now, rounded down (step 2); at most lookback_hours."
                }
              }
            }
          },
          "opened_prs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "number",
                "title",
                "url",
                "hours_ago"
              ],
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "html_url exactly as in the evidence."
                },
                "author": {
                  "type": "string",
                  "description": "The author's login, as in the evidence."
                },
                "hours_ago": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Whole hours from merged_at (merged) or created_at (opened) to now, rounded down (step 2); at most lookback_hours."
                }
              }
            }
          },
          "themes": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "label",
                "summary",
                "refs"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 40
                },
                "summary": {
                  "type": "string",
                  "description": "One plain-language sentence on the outcome, citing PR/commit numbers in parentheses."
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "PR numbers (#12) or short commit SHAs the theme rests on."
                }
              }
            }
          },
          "housekeeping_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Trivial and bot changes collapsed into the housekeeping line."
          },
          "more_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Changes summarized only as '…and N more' on a high-volume day."
          }
        }
      }
    },
    "empty_result": {
      "type": "boolean",
      "description": "True when no repository had notable activity."
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
