{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "candidates",
    "counts",
    "dropped",
    "next_queries",
    "report",
    "state_sheet_values"
  ],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "description": "New companies that plausibly fit the ICP, best first. Pass the list straight to list-prepare as items with identity_keys [domain, name].",
      "items": {
        "type": "object",
        "required": [
          "name",
          "item_key",
          "fit_reason",
          "fit_strength",
          "signal",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The company's name as the evidence spells it."
          },
          "domain": {
            "type": "string",
            "maxLength": 253,
            "description": "The company's own domain, only when the evidence shows it. Lower case, no scheme, no www., no path."
          },
          "item_key": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(domain|name):\\S+$",
            "description": "domain:<domain>, else name:<name lower case, spaces as ->. Equal to the key list-prepare builds with identity_keys [domain, name]."
          },
          "fit_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "One line: which ICP criterion the source shows met, in plain text."
          },
          "fit_strength": {
            "type": "string",
            "enum": [
              "strong",
              "plausible"
            ]
          },
          "signal": {
            "type": "string",
            "enum": [
              "firmographic",
              "behavior",
              "pain",
              "timing"
            ],
            "description": "The kind of evidence behind fit_reason."
          },
          "source_id": {
            "type": "string",
            "pattern": "^S[0-9]+$",
            "description": "The report source that shows fit_reason."
          },
          "source_url": {
            "type": "string",
            "description": "That source's url, copied exactly, so the candidate makes sense outside the report."
          },
          "found_via": {
            "type": "string",
            "enum": [
              "directory",
              "search",
              "news",
              "community",
              "job_post",
              "other"
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "mentioned",
        "returned",
        "already_seen",
        "excluded",
        "not_a_fit",
        "over_limit"
      ],
      "additionalProperties": false,
      "properties": {
        "mentioned": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct companies found in the evidence after merging duplicates."
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "already_seen": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "not_a_fit": {
          "type": "integer",
          "minimum": 0
        },
        "over_limit": {
          "type": "integer",
          "minimum": 0
        },
        "seen_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Companies in the previous state plus this run's new ones."
        }
      }
    },
    "dropped": {
      "type": "array",
      "maxItems": 100,
      "description": "Companies found but not returned, with the reason. At most 100; counts has the totals.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "item_key",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "item_key": {
            "type": "string",
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "enum": [
              "already_seen",
              "excluded",
              "icp_exclusion",
              "not_a_fit",
              "over_limit"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "next_queries": {
      "type": "array",
      "maxItems": 10,
      "description": "Follow-up searches for the next run or a second pass. Empty when count new candidates were found.",
      "items": {
        "type": "object",
        "required": [
          "query",
          "target",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "target": {
            "type": "string",
            "enum": [
              "web",
              "news",
              "community",
              "jobs",
              "directory"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "state_out": {
      "title": "State to remember",
      "description": "What a skill that compares over time asks the agent to save for the next run. Copied into properties.state_out of each output schema that has a state_out property. The skill never saves it; a later write step does (Sheets, Notion, a memory connector, or platform memory once it exists).",
      "type": "object",
      "required": [
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "item_key",
              "fingerprint",
              "observed_at"
            ],
            "additionalProperties": false,
            "properties": {
              "item_key": {
                "type": "string",
                "pattern": "^[a-z_]+:\\S+$",
                "maxLength": 200
              },
              "fingerprint": {
                "type": "string",
                "maxLength": 500,
                "description": "A short, stable summary of what was observed (e.g. sorted event urls, a price string), compared on the next run to detect change."
              },
              "observed_at": {
                "type": "string",
                "description": "The run's `now` input."
              },
              "data": {
                "type": "object",
                "description": "Small extra fields the next run needs. Keep it under 2 KB."
              }
            }
          }
        }
      }
    },
    "state_sheet_values": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 1,
      "description": "state_out.entries as spreadsheet cells: item_key, fingerprint, observed_at, data_json. null when there are no entries."
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
