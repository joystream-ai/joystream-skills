{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ranked",
    "shown",
    "skipped_count",
    "failed",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "ranked": {
      "type": "array",
      "maxItems": 100,
      "description": "Every branch with status ok or no_evidence, in rank order. Values are copied from each branch's item_result, never changed.",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "item_label",
          "status",
          "headline",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "item_label": {
            "type": "string",
            "maxLength": 120
          },
          "item_key": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[a-z_]+:[^@\\s]+$",
            "description": "The branch's item_result.item_key copied unchanged, so a later run or a store can join on it. Left out when the key holds an email address (contains @) or the branch gave none."
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_evidence"
            ]
          },
          "verdict": {
            "type": "string",
            "maxLength": 40
          },
          "score": {
            "type": "number"
          },
          "score_scale": {
            "type": "string",
            "maxLength": 20
          },
          "headline": {
            "type": "string",
            "maxLength": 200
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            },
            "description": "The branch's item_result.source_ids, renumbered to ids in report.sources."
          }
        }
      }
    },
    "shown": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25,
      "description": "min(top_n, number of ranked items)."
    },
    "skipped_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Branches whose slot was empty."
    },
    "failed": {
      "type": "array",
      "maxItems": 100,
      "description": "Branches that errored or returned nothing, named by their slot's item.",
      "items": {
        "type": "object",
        "required": [
          "item_label",
          "branch",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "item_label": {
            "type": "string",
            "maxLength": 120,
            "description": "The slot's label from list-prepare; empty when no prepare output is available."
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The branch's step name or list position."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
