{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "top_n",
    "item_kind",
    "rank_by"
  ],
  "additionalProperties": true,
  "properties": {
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25,
      "description": "How many ranked items the report shows; the rest become one '...and N more' line."
    },
    "item_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "A word for the reader: company, person, meeting, ..."
    },
    "rank_by": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "Ordering keys, applied in order; ties on every key are broken by item_label.",
      "items": {
        "type": "object",
        "required": [
          "field"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "verdict",
              "score",
              "item_label"
            ]
          },
          "order": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "description": "For field verdict: the verdict words, best first."
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "For score (default desc) and item_label (default asc)."
          }
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "description": "Report title. Default: '<Item kind> ranking'."
    },
    "now": {
      "type": "string",
      "description": "Current time, ISO 8601, for report.meta.generated_at. Optional: without it the skill uses the run start time from its instructions. Never guessed."
    }
  }
}
