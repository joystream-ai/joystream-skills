{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "identity_matches",
    "topics",
    "stated_views",
    "rejected_count",
    "item_result",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "identity_matches": {
      "type": "array",
      "maxItems": 20,
      "description": "One per source kept by the identity check.",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "match_basis",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "match_basis": {
            "type": "string",
            "enum": [
              "profile_url",
              "name_company_role",
              "name_company",
              "name_role"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "topic",
          "source_ids",
          "published_at",
          "months_ago"
        ],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            }
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$",
            "description": "The newest date stated by the cited source(s), YYYY-MM-DD or YYYY-MM; null when undated."
          },
          "months_ago": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 24,
            "description": "Computed months from published_at to now (step 5); null when undated or without now. Over 24 is left out (step 8)."
          }
        }
      }
    },
    "stated_views": {
      "type": "array",
      "maxItems": 6,
      "description": "Professional views the person stated themselves.",
      "items": {
        "type": "object",
        "required": [
          "view",
          "source_id",
          "published_at",
          "months_ago"
        ],
        "additionalProperties": false,
        "properties": {
          "view": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$",
            "description": "The newest date stated by the cited source(s), YYYY-MM-DD or YYYY-MM; null when undated."
          },
          "months_ago": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 24,
            "description": "Computed months from published_at to now (step 5); null when undated or without now. Over 24 is left out (step 8)."
          }
        }
      }
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Sources rejected by the identity check (other people with the same name, name-only matches)."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Match",
        "Uncertain",
        "No match"
      ],
      "description": "Absent only for a skipped slot."
    },
    "match_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "item_result": {
      "title": "Per-item result",
      "description": "What a per-item judge skill returns next to its own fields, so results-rank can combine the branches of any fan-out agent. Copied into properties.item_result of each output schema that has an item_result property.",
      "type": "object",
      "required": [
        "item",
        "item_key",
        "item_label",
        "status",
        "headline",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "object",
            "null"
          ],
          "description": "The item judged, echoed from the slot it came from. Null for a skipped (empty) slot."
        },
        "item_key": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^$|^[a-z_]+:\\S+$",
          "description": "The stable identity key list-prepare gave this item (e.g. domain:acme.example, email:jo@acme.example). Copied unchanged. Memory, de-duplication across runs and later agents join on it. Empty only for a skipped slot."
        },
        "item_label": {
          "type": "string",
          "maxLength": 120,
          "description": "How to name the item in a list, e.g. 'Acme (acme.example)'. Empty for a skipped slot."
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "skipped",
            "no_evidence"
          ],
          "description": "skipped = the slot was empty; no_evidence = judged, but nothing usable was found. A failed branch is detected by the platform, not reported here."
        },
        "verdict": {
          "type": "string",
          "maxLength": 40,
          "description": "The skill's own verdict word, e.g. Pursue, Research, Reject."
        },
        "score": {
          "type": "number",
          "description": "The skill's own score; score_scale gives its range."
        },
        "score_scale": {
          "type": "string",
          "maxLength": 20,
          "description": "E.g. '0-5'."
        },
        "headline": {
          "type": "string",
          "maxLength": 200,
          "description": "One-line reason in plain text."
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "description": "Ids in this skill's report.sources that back the headline."
        }
      }
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
