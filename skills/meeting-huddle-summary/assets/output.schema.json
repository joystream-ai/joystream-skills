{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "meeting_date",
    "attendees",
    "tldr",
    "decisions",
    "action_items",
    "blockers",
    "updates",
    "open_questions",
    "notion_page",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "meeting_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "attendees": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 200,
        "minLength": 1
      }
    },
    "tldr": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "string",
        "maxLength": 250,
        "minLength": 1
      },
      "description": "Most important first."
    },
    "decisions": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "quote"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "decided_by": {
            "type": "string",
            "maxLength": 200,
            "description": "An attendee name, only when one attendee made the call."
          },
          "quote": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1,
            "description": "Copied character for character from one turn."
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "owner",
          "quote"
        ],
        "properties": {
          "task": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "description": "An attendee name, or 'unassigned'."
          },
          "due": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "description": "YYYY-MM-DD when that date was stated, else the words as said. Absent when not said."
          },
          "tentative": {
            "type": "boolean"
          },
          "quote": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1,
            "description": "Copied character for character from one turn."
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker"
        ],
        "properties": {
          "blocker": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "raised_by": {
            "type": "string",
            "maxLength": 200
          },
          "needs": {
            "type": "string",
            "maxLength": 200,
            "description": "Who or what can unblock it, only when said."
          },
          "quote": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1,
            "description": "Copied character for character from one turn."
          }
        }
      }
    },
    "updates": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person",
          "update"
        ],
        "properties": {
          "person": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "update": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300,
        "minLength": 1
      }
    },
    "notion_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "properties",
        "body_md"
      ],
      "description": "Shaped for a page-create step (Notion, Google Docs, any document tool).",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Date",
            "Attendees"
          ],
          "properties": {
            "Date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "Attendees": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              }
            }
          }
        },
        "body_md": {
          "type": "string",
          "maxLength": 12000,
          "minLength": 1,
          "description": "Sections: TL;DR, Decisions, Action items, Blockers, Updates, Open questions."
        }
      }
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
