{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "what_they_do",
    "recent_events",
    "likely_problem_owner",
    "angles",
    "open_questions",
    "brief_text",
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "what_they_do": {
      "type": "object",
      "required": [
        "text",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "One or two plain sentences, or 'unknown'."
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          }
        }
      }
    },
    "recent_events": {
      "type": "array",
      "maxItems": 8,
      "description": "Dated events inside [now - lookback_days, now], newest first.",
      "items": {
        "type": "object",
        "required": [
          "event",
          "date",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "YYYY-MM-DD, as stated in the evidence."
          },
          "category": {
            "type": "string",
            "enum": [
              "funding",
              "hiring",
              "launch",
              "leadership",
              "partnership",
              "expansion",
              "other"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          }
        }
      }
    },
    "likely_problem_owner": {
      "type": "object",
      "required": [
        "guess",
        "basis",
        "is_guess",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "guess": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "A role (and a person only when a source names them in it), or 'unknown'."
        },
        "basis": {
          "type": "string",
          "maxLength": 300,
          "description": "Why this role, from the evidence."
        },
        "is_guess": {
          "const": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          }
        }
      }
    },
    "angles": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "brief_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800,
      "description": "Paste-ready plain-text brief, at most 1,800 characters."
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
