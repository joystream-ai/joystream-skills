{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "website-seo-changes output",
  "type": "object",
  "required": [
    "outcome",
    "site",
    "taken_at",
    "previous_at",
    "score",
    "quiet",
    "changes",
    "snapshot",
    "sheet_values",
    "report",
    "sentence",
    "unknowns"
  ],
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "first_run",
        "error"
      ],
      "description": "first_run: no previous snapshot, so this run is the baseline. error: no usable audit; nothing compared and the previous snapshot is kept."
    },
    "site": {
      "type": "string"
    },
    "taken_at": {
      "type": "string",
      "description": "The run's now, else the script's clock."
    },
    "previous_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the snapshot compared against was taken."
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The audit's overall score this run."
    },
    "quiet": {
      "type": "boolean",
      "description": "Nothing changed since the previous snapshot."
    },
    "changes": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "score",
        "new",
        "fixed",
        "still_open",
        "ranks",
        "new_competitors",
        "speed"
      ],
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "object",
          "required": [
            "before",
            "after",
            "delta"
          ],
          "additionalProperties": false,
          "properties": {
            "before": {
              "type": [
                "integer",
                "null"
              ]
            },
            "after": {
              "type": [
                "integer",
                "null"
              ]
            },
            "delta": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "new": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "severity",
              "title",
              "pages"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "pages": {
                "type": "integer"
              }
            }
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "severity",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        },
        "still_open": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "severity",
              "title",
              "pages",
              "since",
              "age_days",
              "checks",
              "escalated"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "severity_before": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "pages": {
                "type": "integer"
              },
              "since": {
                "type": "string"
              },
              "age_days": {
                "type": "integer"
              },
              "checks": {
                "type": "integer"
              },
              "escalated": {
                "type": "boolean"
              }
            }
          }
        },
        "ranks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "keyword",
              "before",
              "after",
              "direction"
            ],
            "properties": {
              "keyword": {
                "type": "string"
              },
              "before": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "after": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "entered",
                  "dropped_out"
                ]
              }
            }
          }
        },
        "new_competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "keyword",
              "host"
            ],
            "properties": {
              "keyword": {
                "type": "string"
              },
              "host": {
                "type": "string"
              }
            }
          }
        },
        "speed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "metric",
              "before",
              "after",
              "direction"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "metric": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "better",
                  "worse"
                ]
              }
            }
          }
        }
      }
    },
    "snapshot": {
      "type": [
        "object",
        "null"
      ],
      "description": "What the next run compares against: score, open findings with first-seen dates, rankings and speed ratings. Kept small (about 2 KB)."
    },
    "sheet_values": {
      "type": "array",
      "description": "Two rows for a Google Sheets values update of A1:D2: a header, then the snapshot row (taken_at, site, score, snapshot JSON).",
      "items": {
        "type": "array"
      }
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    },
    "sentence": {
      "type": "string"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
