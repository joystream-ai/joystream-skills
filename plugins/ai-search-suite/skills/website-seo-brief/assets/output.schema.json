{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "mode",
    "site",
    "score",
    "actions",
    "report_markdown",
    "report"
  ],
  "additionalProperties": true,
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "search_console",
        "on_page"
      ],
      "description": "search_console when Search Console opportunities were in the evidence, on_page when only the page audit was."
    },
    "site": {
      "type": "string"
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "The page audit's overall_score, copied."
    },
    "actions": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "page",
          "change",
          "why",
          "issue_ids",
          "impact",
          "extra_clicks",
          "effort",
          "owner",
          "current",
          "proposed"
        ],
        "additionalProperties": false,
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "description": "What to do, in at most 12 words."
          },
          "why": {
            "type": "string",
            "description": "One sentence of evidence, with the numbers from the audit or Search Console."
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The audit finding ids and opportunity types this action fixes."
          },
          "impact": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "extra_clicks": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Copied from the Search Console opportunity; null in on_page mode."
          },
          "effort": {
            "type": "string",
            "enum": [
              "quick fix",
              "project"
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "Web",
              "Content",
              "Eng"
            ]
          },
          "current": {
            "type": "object",
            "required": [
              "title",
              "meta_description",
              "h1"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "meta_description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "h1": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "proposed": {
            "type": "object",
            "required": [
              "title",
              "meta_description",
              "h1",
              "section_outline",
              "internal_link",
              "json_ld"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 60
              },
              "meta_description": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 160
              },
              "h1": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "section_outline": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string"
                }
              },
              "internal_link": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "from_page",
                  "anchor_text"
                ],
                "additionalProperties": false,
                "properties": {
                  "from_page": {
                    "type": "string"
                  },
                  "anchor_text": {
                    "type": "string"
                  }
                }
              },
              "json_ld": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "report_markdown": {
      "type": "string",
      "description": "The full brief in Markdown, for a run file."
    },
    "report": {
      "title": "Channel-neutral report",
      "description": "What every task skill returns for a human to read. channel-message-render turns it into a Slack, Teams, Discord, email or markdown payload. Every citation id must resolve to an entry in sources, and every source url must appear verbatim in the evidence the skill was given.",
      "type": "object",
      "required": [
        "title",
        "summary",
        "severity",
        "sections",
        "sources",
        "unknowns"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Plain text headline, no markup."
        },
        "summary": {
          "type": "string",
          "maxLength": 600,
          "description": "One-paragraph TL;DR in plain text. Empty only when there is nothing to report."
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "attention",
            "action_needed"
          ],
          "description": "Drives color and emphasis in rendering. action_needed only when the reader must do something."
        },
        "sections": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "body_md": {
                "type": "string",
                "maxLength": 2500,
                "description": "Optional prose under the heading. Basic markdown only: bold, italic, links, bullet lists."
              },
              "items": {
                "type": "array",
                "maxItems": 25,
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Ids from sources. Empty only for items that make no factual claim (e.g. a recommendation)."
                    },
                    "confidence": {
                      "type": "string",
                      "enum": [
                        "high",
                        "medium",
                        "low"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Short tag such as a verdict or category, e.g. Pursue, funding."
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]+$"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "The web address exactly as it appears in the evidence. For pasted text, input:<field>."
              },
              "record_ref": {
                "type": "string",
                "pattern": "^[a-z0-9_]+:[^\\s]+$",
                "maxLength": 200,
                "description": "For an API record with no web address (enrichment, CRM, transcript): <provider>:<kind>/<id>, e.g. apollo:person/5f2a. The id must appear in the evidence exactly as given."
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "published_at": {
                "type": "string",
                "description": "ISO 8601 date or datetime when the source states one; omit when unknown, never guess."
              },
              "provider": {
                "type": "string",
                "description": "Which tool returned it, when known (tavily, exa, brave, firecrawl, serpapi, perplexity, github, apollo, peopledatalabs, crustdata, fireflies, gong, granola, input)."
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "record_ref"
                ]
              }
            ]
          },
          "description": "Every cited source. Each has a url, a record_ref, or both."
        },
        "unknowns": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "What could not be established, and why. A first-class result, not a failure."
        },
        "footer": {
          "type": "string",
          "maxLength": 200,
          "description": "E.g. 'Draft — not sent'."
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skill",
            "skill_version",
            "generated_at"
          ],
          "description": "Who produced this report and when, so another agent that reads it later knows what it is reading.",
          "properties": {
            "skill": {
              "type": "string",
              "maxLength": 64,
              "description": "The producing skill's name."
            },
            "skill_version": {
              "type": "string",
              "maxLength": 32,
              "description": "Its metadata.version."
            },
            "generated_at": {
              "type": "string",
              "description": "The run's `now` input (ISO 8601). Never invent a time."
            }
          }
        }
      }
    }
  }
}
